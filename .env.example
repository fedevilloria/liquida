# Entorno de ejecución:
# development | test | production
NODE_ENV=development

# Puerto HTTP de la API
PORT=3000

# Conexión con PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_NAME=comisiones_db

# Origen permitido para el frontend
FRONTEND_URL=http://localhost:4200

# Documentación Swagger
SWAGGER_ENABLED=true

# Cuenta administrativa inicial
# Se utiliza exclusivamente con npm run seed:superuser
SUPERUSER_NAME=Administrador Liquida
SUPERUSER_EMAIL=administrador@example.com
SUPERUSER_PASSWORD=change_me_securely

# Duración del enlace de verificación de correo, en horas
EMAIL_VERIFICATION_EXPIRES_HOURS=24

# Envío de correos
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=change_me@gmail.com
SMTP_PASSWORD=change_me
SMTP_FROM=Liquida <change_me@gmail.com>

# Tiempo mínimo entre reenvíos de verificación, en segundos
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60